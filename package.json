{
  "name": "soup-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "verify": "prisma validate && tsc --noEmit && next build",
    "seed": "prisma db seed",
    "check:repo": "node scripts/repo-check.mjs",
    "check:ai": "node scripts/check-ai-config.mjs",
    "prisma:validate:local": "node scripts/prisma-local.mjs validate",
    "prisma:status:local": "node scripts/prisma-local.mjs migrate status",
    "prisma:deploy:local": "node scripts/prisma-local.mjs migrate deploy",
    "verify:local": "npm run prisma:validate:local && npm run typecheck && npm run build",
    "check:deep": "node scripts/deep-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "seed:soup-partners": "node scripts/import-soup-partners.mjs",
    "import:soup-catalog": "node scripts/import-soup-partner-catalog.mjs",
    "check:syntax": "node scripts/syntax-check.mjs",
    "check:preflight": "node scripts/preflight.mjs",
    "check:migrations": "node scripts/migration-check.mjs",
    "verify:launch": "npm run doctor && npm run check:preflight && npm run check:repo && npm run check:migrations && npm run check:deep && npm run check:syntax && npm run check:ai && npm run check:application-os && npm run check:experience-hardening && npm run check:deploy-candidate && npm run prisma:validate:local && npm run typecheck && npm run build",
    "check:investor-beta": "node scripts/investor-beta-release-check.mjs",
    "check:application-os": "node scripts/application-os-release-check.mjs",
    "import:network-universities": "node scripts/import-network-universities.mjs",
    "import:university-master": "node scripts/import-university-master-catalog.mjs",
    "check:university-catalog": "node scripts/university-catalog-check.mjs",
    "check:ai-readiness": "node scripts/ai-readiness-check.mjs",
    "check:experience-hardening": "node scripts/experience-hardening-check.mjs",
    "check:deploy-candidate": "node scripts/deploy-candidate-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "check:auth": "node scripts/auth-route-audit.mjs",
    "check:any": "node scripts/any-budget-check.mjs",
    "verify:deploy": "npm run test && npm run check:auth && npm run check:validation && npm run check:rls && npm run check:any && npm run check:application-os && npm run check:university-catalog && npm run check:ai-readiness && npm run check:experience-hardening && npm run check:deploy-candidate && npm run prisma:validate:local && npm run typecheck && npm run build",
    "check:validation": "node scripts/validation-coverage-audit.mjs",
    "check:rls": "node scripts/rls-coverage-audit.mjs",
    "check:rls-live": "node scripts/rls-live-verification.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@next/env": "14.2.35",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "^3.4.4",
    "@sentry/nextjs": "^8.42.0",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.8.0",
    "next": "14.2.35",
    "openai": "^4.55.0",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
