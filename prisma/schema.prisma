// ----------------------------------------------------------------------------
// SOUP student journey, partner inventory and transaction orchestration
// Additive to the proven GCI foundation so the fork can be migrated safely.
// ----------------------------------------------------------------------------

enum StudentJourneyStage {
  EXPLORING
  SHORTLISTING
  APPLYING
  AWAITING_DECISIONS
  OFFER_RECEIVED
  VISA_PREPARATION
  PRE_DEPARTURE
  ARRIVED
}

enum PartnerType {
  UNIVERSITY
  ACCOMMODATION
  INSURANCE
  STUDENT_FINANCE
  SCHOLARSHIP
  TRAVEL
  OTHER
}

enum PartnershipStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum ApplicationOwnership {
  SOUP_MANAGED
  STUDENT_MANAGED_EXTERNAL
  ASSISTED_EXTERNAL
}

enum StudentApplicationStatus {
  SHORTLISTED
  DOCUMENTS_REQUIRED
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  OFFER_RECEIVED
  CONDITIONAL_OFFER
  REJECTED
  WITHDRAWN
  ENROLLED
}

enum ChecklistKind {
  ADMISSION
  VISA
  PRE_DEPARTURE
  ARRIVAL
  GENERAL
}

enum ChecklistItemStatus {
  NOT_STARTED
  ACTION_REQUIRED
  WAITING_FOR_DOCUMENT
  DOCUMENT_UPLOADED
  COMPLETE
  NOT_APPLICABLE
  BLOCKED
}

enum ApplicationFeeStatus {
  UNKNOWN
  NOT_REQUIRED
  REQUIRED
  STUDENT_PAYING
  SOUP_PAYING
  PENDING
  PAID
  WAIVED
  REFUNDED
}

enum ApplicationEligibilityStatus {
  NOT_CHECKED
  LIKELY_ELIGIBLE
  NEEDS_REVIEW
  NOT_ELIGIBLE
}

enum ServiceReferralType {
  ACCOMMODATION
  INSURANCE
  STUDENT_FINANCE
  SCHOLARSHIP
  TRAVEL
  ATTESTATION
  OTHER
}

enum ServiceReferralStatus {
  RECOMMENDED
  OPENED
  STARTED
  COMPLETED
  DECLINED
  EXTERNAL_ONLY
}

model StudentCase {
  id                  String              @id @default(uuid())
  profileId           String              @unique
  profile             Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stage               StudentJourneyStage @default(EXPLORING)
  targetDegreeLevel   String?
  targetSubject       String?
  preferredIntake    String?
  preferredRegions    Json?
  preferredCountries  Json?
  searchScope         String?
  academicBackgroundSummary String?
  englishProficiencySummary String?
  fundingSummary       String?
  budgetMin           Decimal?            @db.Decimal(12, 2)
  budgetMax           Decimal?            @db.Decimal(12, 2)
  budgetCurrency      String?
  studyLanguage       String?
  goals               Json?
  constraints         Json?
  // The Common-App-style "fill once" core profile (see
  // src/lib/applications/coreProfile.ts): structured detail beyond the
  // existing free-text summary fields above, entered once via /profile/*
  // and reused across every university-specific application rather than
  // re-collected per school. Kept as JSON, matching goals/constraints above,
  // because each of these is a loosely-structured bundle of many optional
  // sub-fields (see the field spec in coreProfile.ts) rather than a single
  // scalar — a JSON column here is one additive, low-risk migration instead
  // of dozens of new individual nullable columns for fields most students
  // will only partially fill in.
  coreProfileDetails  Json?
  fundingDetails      Json?
  educationHistory    Json?
  testingDetails      Json?
  nextAction          String?
  humanHandoffActive  Boolean             @default(false)
  assignedStaffUserId String?
  handoffReason       String?
  handoffStartedAt    DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  shortlists          UniversityShortlist[]
  applications        StudentApplication[]
  checklists          JourneyChecklist[]
  referrals           ServiceReferral[]

  @@index([stage, updatedAt])
  @@map("student_cases")
}

model Partner {
  id                  String            @id @default(uuid())
  type                PartnerType
  name                String
  slug                String            @unique
  status              PartnershipStatus @default(ACTIVE)
  country             String?
  city                String?
  websiteUrl          String?
  transactionUrl      String?
  internalPriority    Int               @default(100)
  commercialMetadata  Json?
  publicMetadata      Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  universities        University[]
  referrals           ServiceReferral[]

  @@index([type, status, internalPriority])
  @@map("partners")
}

model University {
  id                  String    @id @default(uuid())
  partnerId           String?
  partner             Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  name                String
  country             String
  city                String?
  websiteUrl          String?
  isPublic            Boolean?
  sourceUrl           String?
  sourceCheckedAt     DateTime?
  publicMetadata      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  programs            UniversityProgram[]
  shortlistItems      UniversityShortlistItem[]
  applications        StudentApplication[]

  @@unique([name, country])
  @@index([country, name])
  @@index([partnerId])
  @@map("universities")
}

model UniversityProgram {
  id                  String    @id @default(uuid())
  universityId        String
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title               String
  level               String
  field               String?
  studyMode           String?
  language            String?
  duration            String?
  tuitionAmount       Decimal?  @db.Decimal(12, 2)
  tuitionCurrency     String?
  intake              String?
  applicationDeadline String?
  applicationUrl      String?
  sourceUrl           String?
  sourceCheckedAt     DateTime?
  requirements        Json?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shortlistItems      UniversityShortlistItem[]
  applications        StudentApplication[]

  @@index([universityId, level, active])
  @@index([field])
  @@map("university_programs")
}

model UniversityShortlist {
  id                  String      @id @default(uuid())
  profileId           String
  profile             Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentCaseId       String
  studentCase         StudentCase @relation(fields: [studentCaseId], references: [id], onDelete: Cascade)
  title               String      @default("University Application Plan")
  regionScope         String?
  version             Int         @default(1)
  generatedBy         String      @default("SOUP_COUNSELOR")
  researchSummary     Json?
  generatedAt         DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items               UniversityShortlistItem[]

  @@index([profileId, generatedAt])
  @@index([studentCaseId, generatedAt])
  @@map("university_shortlists")
}

model UniversityShortlistItem {
  id                  String              @id @default(uuid())
  shortlistId         String
  shortlist           UniversityShortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  universityId        String
  university          University          @relation(fields: [universityId], references: [id])
  programId           String?
  program             UniversityProgram?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  position            Int
  isPartnerAtGeneration Boolean           @default(false)
  eligibilityStatus   String?
  rationale           String?
  cautions             Json?
  sourceUrls          Json?
  studentDecision     String?
  studentDecisionAt   DateTime?
  createdAt           DateTime            @default(now())

  @@index([shortlistId, position])
  @@index([universityId])
  @@index([studentDecision])
  @@map("university_shortlist_items")
}

model StudentApplication {
  id                  String                   @id @default(uuid())
  profileId           String
  profile             Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentCaseId       String
  studentCase         StudentCase              @relation(fields: [studentCaseId], references: [id], onDelete: Cascade)
  universityId        String?
  university          University?              @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId           String?
  program             UniversityProgram?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  ownership           ApplicationOwnership
  status              StudentApplicationStatus @default(SHORTLISTED)
  externalApplicationUrl String?
  externalReference   String?
  submittedAt         DateTime?
  decisionAt          DateTime?
  offerDocumentId     String?                  @unique
  offerDocument       Document?                @relation("ApplicationOfferDocument", fields: [offerDocumentId], references: [id], onDelete: SetNull)
  notes               String?
  applicationKey      String?                   @unique
  // Unguessable per-application token embedded in the inbound reply
  // address the student emails to (app-{inboundReplyToken}@minoihon.resend.app).
  // Generated lazily by getOrCreateInboundReplyToken() — see
  // src/lib/applications/inboundReply.ts — rather than backfilled for
  // every existing row, since nothing surfaced the address before this
  // feature existed. Deliberately NOT derived from applicationId/other
  // public identifiers: it is the only thing that authorizes an inbound
  // email to be attached to this specific application's communication
  // history, so it must not be guessable from a sequential or otherwise
  // public value.
  inboundReplyToken   String?                   @unique
  intake              String?
  startDate           DateTime?
  deadlineAt          DateTime?
  deadlineSourceUrl   String?
  deadlineCheckedAt   DateTime?
  eligibilityStatus   ApplicationEligibilityStatus @default(NOT_CHECKED)
  eligibilityCheckedAt DateTime?
  eligibilitySourceUrl String?
  eligibilityNotes    Json?
  applicationFeeAmount Decimal?                 @db.Decimal(12, 2)
  applicationFeeCurrency String?
  applicationFeeStatus ApplicationFeeStatus     @default(UNKNOWN)
  assignedStaffUserId String?
  studentDeclarationAt DateTime?
  studentApprovedAt   DateTime?
  lastStudentActionAt DateTime?
  lastSoupActionAt    DateTime?
  withdrawnAt         DateTime?
  withdrawalReason    String?
  submissionEvidence  Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  documents           StudentApplicationDocument[]
  checklists          JourneyChecklist[]
  events              StudentApplicationEvent[]
  payments            Payment[]
  offerConditions     OfferCondition[]
  messages            ApplicationMessage[]

  @@index([profileId, status, updatedAt])
  @@index([studentCaseId, status])
  @@index([universityId])
  @@map("student_applications")
}

// A single application's email communication history. Currently only
// populated by the Resend inbound webhook (see
// src/app/api/resend/inbound/route.ts) when a student replies to a SOUP
// email, and OUTBOUND replies staff send from the admin application page
// (see sendApplicationReply in src/app/actions/adminMessages.ts).
model ApplicationMessage {
  id              String                      @id @default(uuid())
  applicationId   String
  application     StudentApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  direction       ApplicationMessageDirection @default(INBOUND)
  // Set only for OUTBOUND rows: the staff member who sent the reply.
  // Nullable because inbound messages have no SOUP-side sender.
  sentByUserId    String?
  sentBy          User?                       @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  // Resend's email_id — for INBOUND this is the webhook delivery's id; for
  // OUTBOUND it's the id Resend's send API returns. The hard uniqueness
  // constraint (not just an application-level check) is what makes inbound
  // webhook retries safe: Resend/Svix redeliver on anything short of a
  // fast 2xx, and re-processing the same email_id must never create a
  // second row.
  providerEventId String                      @unique
  messageId       String?
  inReplyTo       String?
  references      String?
  fromAddress     String
  toAddresses     Json
  ccAddresses     Json?
  subject         String?
  textBody        String?
  htmlBody        String?
  // Filename/content-type/size only — never the attachment's raw content.
  // The webhook payload's own attachment bytes (if Resend ever includes
  // them) are deliberately stripped before this is written; storing
  // arbitrary email attachment content in the primary database was never
  // asked for and would make this table's size unbounded by student
  // behavior rather than by SOUP's own data.
  attachments     Json?
  receivedAt      DateTime
  createdAt       DateTime                    @default(now())

  @@index([applicationId, receivedAt])
  @@map("application_messages")
}

enum ApplicationMessageDirection {
  INBOUND
  OUTBOUND
}

model StudentApplicationEvent {
  id                  String             @id @default(uuid())
  applicationId       String
  application         StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUserId         String?
