model CounselorSession {
  id                String                 @id @default(uuid())
  profileId         String
  profile           Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  counselorUserId   String?
  counselor         User?                  @relation("CounselorSessionCounselor", fields: [counselorUserId], references: [id], onDelete: SetNull)
  requestedByUserId String
  requestedBy       User                   @relation("CounselorSessionRequester", fields: [requestedByUserId], references: [id])
  status            CounselorSessionStatus @default(REQUESTED)
  requestedDate     DateTime?
  requestedTimeNote String?
  scheduledFor      DateTime?
  durationMinutes   Int                    @default(30)
  meetingUrl        String?
  studentNote       String?
  staffNote         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([profileId, status, scheduledFor])
  @@index([counselorUserId, status, scheduledFor])
  @@map("counselor_sessions")
}

model AiRateLimitCounter {
  subject             String   @id
  windowStart         DateTime
  count               Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("ai_rate_limit_counters")
}

model StudentApplicationDocument {
  id                  String             @id @default(uuid())
  applicationId       String
  application         StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId          String
  document            Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentRole        String
  required            Boolean            @default(true)
  createdAt           DateTime           @default(now())

  @@unique([applicationId, documentId])
  @@index([documentId])
  @@map("student_application_documents")
}

model JourneyChecklist {
  id                  String        @id @default(uuid())
  profileId           String
  profile             Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentCaseId       String
  studentCase         StudentCase   @relation(fields: [studentCaseId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         StudentApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind                ChecklistKind
  title               String
  destinationCountry  String?
  authorityName       String?
  sourceUrl           String?
  sourceCheckedAt     DateTime?
  sourceSnapshot      Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               JourneyChecklistItem[]

  @@index([profileId, kind, updatedAt])
  @@index([applicationId, updatedAt])
  @@map("journey_checklists")
}

model JourneyChecklistItem {
  id                  String              @id @default(uuid())
  checklistId         String
  checklist           JourneyChecklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  position            Int
  status              ChecklistItemStatus @default(NOT_STARTED)
  required            Boolean             @default(true)
  externalActionUrl   String?
  externalActionLabel String?
  documentId          String?
  document            Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  completedAt         DateTime?
  dueAt               DateTime?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([checklistId, position])
  @@index([status, dueAt])
  @@map("journey_checklist_items")
}

model ServiceReferral {
  id                  String                @id @default(uuid())
  profileId           String
  profile             Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentCaseId       String
  studentCase         StudentCase           @relation(fields: [studentCaseId], references: [id], onDelete: Cascade)
  type                ServiceReferralType
  partnerId           String?
  partner             Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  status              ServiceReferralStatus @default(RECOMMENDED)
  title               String
  externalUrl         String?
  counselorRationale  String?
  sourceSessionId     String?
  sourceMessageId     String?
  partnerReference    String?
  convertedAt         DateTime?
  revenueAmount       Decimal?              @db.Decimal(12, 2)
  revenueCurrency     String?
  commissionAmount    Decimal?              @db.Decimal(12, 2)
  commissionCurrency  String?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([profileId, type, updatedAt])
  @@index([partnerId, status])
  @@index([sourceSessionId])
  @@map("service_referrals")
}


model Payment {
  id                String        @id @default(uuid())
  profileId         String
  profile           Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  applicationId     String?
  application       StudentApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type              PaymentType
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  title             String
  description       String?
  provider          String?
  providerSessionId String?       @unique
  providerPaymentId String?
  metadata          Json?
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([profileId, status, createdAt])
  @@index([applicationId, status])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// SOUP Companion — external-site browser extension pairing, devices and audit
// trail. Additive only. The extension never receives a Supabase session
// cookie or long-lived secret directly: a student generates a short-lived
// pairing code from the signed-in web app, the extension redeems it once for
// a device-scoped bearer token, and only that token's hash is ever stored.
// ----------------------------------------------------------------------------

model CompanionPairingCode {
  id         String    @id @default(uuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([profileId, createdAt])
  @@map("companion_pairing_codes")
}

model CompanionDevice {
  id         String    @id @default(uuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  fillEvents CompanionFillEvent[]

  @@index([profileId, revokedAt])
  @@map("companion_devices")
}

enum CompanionFillOutcome {
  COMPLETED
  PARTIAL
  NEEDS_INPUT
  ERROR
}

model CompanionFillEvent {
  id              String                @id @default(uuid())
  profileId       String
  profile         Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deviceId        String
  device          CompanionDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  portalHost      String
  pageUrl         String
  fieldsDetected  Int                   @default(0)
  fieldsFilled    Int                   @default(0)
  fieldsNeedInput Int                   @default(0)
  outcome         CompanionFillOutcome  @default(COMPLETED)
  createdAt       DateTime              @default(now())

  @@index([profileId, createdAt])
  @@index([deviceId, createdAt])
  @@map("companion_fill_events")
}
