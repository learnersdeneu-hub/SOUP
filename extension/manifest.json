{
  "manifest_version": 3,
  "name": "SOUP Companion",
  "short_name": "SOUP Companion",
  "version": "1.0.0",
  "description": "SOUP sits beside your university, visa and accommodation application forms and helps you complete them using information already saved in your SOUP account.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Open SOUP Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.soupassist.com/*", "*://soupassist.com/*"],
      "js": ["lib/field-dictionary.js", "content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
